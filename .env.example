# Replace every example with values from your own network.
UNIFI_URL=https://controller.example.test:8443
UNIFI_USERNAME=readonly-mqtt-user
# Set a direct value, or leave empty and use UNIFI_PASSWORD_FILE with Compose secrets.
UNIFI_PASSWORD=
UNIFI_AP_MACS=00:11:22:33:44:55
UNIFI_POLL_INTERVAL_SECS=5
# Leave disabled unless your controller uses a certificate you cannot validate.
UNIFI_TLS_INSECURE=false

# Use a broker hostname reachable from the container.
MQTT_HOST=mqtt.example.test
MQTT_PORT=1883
MQTT_USERNAME=
# Set a direct value, or leave empty and use MQTT_PASSWORD_FILE with Compose secrets.
MQTT_PASSWORD=
